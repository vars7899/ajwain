        "category": "Ajwain"
      },
      {
        "command": "ajwain.startWork",
        "title": "Start work (branch / worktree)",
        "category": "Ajwain",
        "icon": "$(git-branch)"
      },
      {
        "command": "ajwain.copyBranch",
        "title": "Copy branch name",
        "category": "Ajwain"
      },
      {
        "command": "ajwain.openInBrowser",
        "title": "Open in browser",
        "category": "Ajwain",
        "icon": "$(link-external)"
      },
      {
        "command": "ajwain.currentActions",
        "title": "Actions for current branch's ticket",
        "category": "Ajwain"
      },
      {
        "command": "ajwain.today",
        "title": "Today: log time & wrap up",
        "category": "Ajwain",
        "icon": "$(calendar)"
      },
      {
        "command": "ajwain.breakdown",
