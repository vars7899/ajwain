{
  "name": "ajwain",
  "displayName": "Ajwain",
  "description": "Project management in your editor: boards, sprints, tickets, timers, your day at a glance, and a slot machine for picking what's next.",
  "version": "0.13.2",
  "publisher": "ajwain",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vars7899/ajwain.git"
  },
  "homepage": "https://github.com/vars7899/ajwain#readme",
  "bugs": {
    "url": "https://github.com/vars7899/ajwain/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./extension.js",
  "bin": {
    "ajwain": "./cli.mjs"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "package": "npx --yes @vscode/vsce package --no-rewrite-relative-links",
    "dev": "node test/mock-api.mjs"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ajwain",
          "title": "Ajwain",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "ajwain": [
        {
          "type": "webview",
          "id": "ajwain.home",
          "name": "Home"
        },
        {
          "id": "ajwain.issues",
          "name": "Issue tree",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "ajwain.issues",
        "contents": "Sign in to see your tickets.\n[Sign in](command:ajwain.signIn)",
        "when": "!ajwain.signedIn"
      },
      {
        "view": "ajwain.issues",
        "contents": "[Open board](command:ajwain.openBoard)",
        "when": "ajwain.signedIn"
      }
    ],
    "commands": [
      {
        "command": "ajwain.openBoard",
        "title": "Open board",
        "category": "Ajwain",
        "icon": "$(layout)"
      },
      {
        "command": "ajwain.signIn",
        "title": "Sign in",
        "category": "Ajwain"
      },
      {
        "command": "ajwain.signOut",
        "title": "Sign out",
        "category": "Ajwain"
      },
      {
        "command": "ajwain.setServer",
        "title": "Change server…",
        "category": "Ajwain"
      },
      {
        "command": "ajwain.pickWorkspace",
        "title": "Switch workspace",
        "category": "Ajwain",
        "icon": "$(organization)"
      },
      {
        "command": "ajwain.refresh",
        "title": "Refresh",
        "category": "Ajwain",
        "icon": "$(refresh)"
      },
      {
        "command": "ajwain.create",
        "title": "Create ticket",
        "category": "Ajwain",
        "icon": "$(add)"
      },
      {
        "command": "ajwain.openIssue",
        "title": "Open ticket by key",
        "category": "Ajwain"
      },
      {
        "command": "ajwain.edit",
